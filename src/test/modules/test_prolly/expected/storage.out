SET max_parallel_workers_per_gather = 0;
CREATE TABLE p(id int, value text COLLATE "C", flag bool, payload bytea) USING dolt_prolly_table;
INSERT INTO p VALUES (3,'three',true,'\x00ff'),(1,'one',false,''),(2,'two',NULL,NULL),(2,'two',NULL,NULL);
SELECT * FROM p ORDER BY id;
 id | value | flag | payload 
----+-------+------+---------
  1 | one   | f    | \x
  2 | two   |      | 
  2 | two   |      | 
  3 | three | t    | \x00ff
(4 rows)

SELECT count(DISTINCT ctid), count(*) FROM p;
 count | count 
-------+-------
     4 |     4
(1 row)

CREATE TABLE q(LIKE p) USING dolt_prolly_table;
INSERT INTO q SELECT * FROM p ORDER BY id DESC;
SELECT dolt_prolly_root('p') = dolt_prolly_root('q') AS canonical_rows;
 canonical_rows 
----------------
 t
(1 row)

CREATE INDEX pi ON p USING btree(id DESC, value ASC) INCLUDE(flag);
CREATE INDEX qi ON q USING btree(id DESC, value ASC) INCLUDE(flag);
SELECT am.amname FROM pg_class c JOIN pg_am am ON am.oid=c.relam WHERE c.oid='pi'::regclass;
      amname       
-------------------
 dolt_prolly_index
(1 row)

SELECT dolt_prolly_root('pi')=dolt_prolly_root('qi') AS canonical_indexes;
 canonical_indexes 
-------------------
 t
(1 row)

SET enable_seqscan = off;
EXPLAIN (COSTS OFF) SELECT id,value FROM p WHERE id>=2 ORDER BY id DESC, value;
          QUERY PLAN           
-------------------------------
 Index Only Scan using pi on p
   Index Cond: (id >= 2)
(2 rows)

SELECT id,value FROM p WHERE id>=2 ORDER BY id DESC, value;
 id | value 
----+-------
  3 | three
  2 | two
  2 | two
(3 rows)

SELECT id,value FROM p ORDER BY id ASC, value DESC;
 id | value 
----+-------
  1 | one
  2 | two
  2 | two
  3 | three
(4 rows)

SELECT id FROM p WHERE id IN (1,3) ORDER BY id;
 id 
----
  1
  3
(2 rows)

SELECT a.id,b.value FROM p a JOIN q b USING(id) WHERE a.id=1;
 id | value 
----+-------
  1 | one
(1 row)

UPDATE p SET value='changed' WHERE id=3 RETURNING id,value;
 id |  value  
----+---------
  3 | changed
(1 row)

DELETE FROM p WHERE id=1 RETURNING id;
 id 
----
  1
(1 row)

SELECT id,value FROM p ORDER BY id;
 id |  value  
----+---------
  2 | two
  2 | two
  3 | changed
(3 rows)

BEGIN;
INSERT INTO p VALUES(9,'rolled back',true,NULL);
SAVEPOINT s;
DELETE FROM p WHERE id=2;
ROLLBACK TO s;
SELECT id,value FROM p ORDER BY id;
 id |    value    
----+-------------
  2 | two
  2 | two
  3 | changed
  9 | rolled back
(4 rows)

ROLLBACK;
SELECT id,value FROM p ORDER BY id;
 id |  value  
----+---------
  2 | two
  2 | two
  3 | changed
(3 rows)

CREATE TABLE u(id bigint PRIMARY KEY, v smallint) USING dolt_prolly_table;
INSERT INTO u VALUES(-9223372036854775808,-32768),(9223372036854775807,32767);
SELECT * FROM u ORDER BY id;
          id          |   v    
----------------------+--------
 -9223372036854775808 | -32768
  9223372036854775807 |  32767
(2 rows)

INSERT INTO u VALUES(9223372036854775807,1);
ERROR:  duplicate key violates unique constraint "u_pkey"
SELECT count(*) FROM u;
 count 
-------
     2
(1 row)

BEGIN;
TRUNCATE u;
SELECT count(*) FROM u;
 count 
-------
     0
(1 row)

ROLLBACK;
SELECT count(*) FROM u;
 count 
-------
     2
(1 row)

CREATE INDEX nullidx ON p(flag NULLS FIRST,id DESC);
SELECT flag,id FROM p WHERE flag IS NULL ORDER BY flag NULLS FIRST,id DESC;
 flag | id 
------+----
      |  2
      |  2
(2 rows)

CREATE TABLE large_text(t text COLLATE "C") USING dolt_prolly_table;
INSERT INTO large_text VALUES(repeat('x',20000));
SELECT length(t) FROM large_text;
 length 
--------
  20000
(1 row)

CREATE INDEX bad_hash ON p USING hash(id);
ERROR:  prolly phase 2 does not support other index families
CREATE INDEX bad_expr ON p((id+1));
ERROR:  prolly phase 2 does not support expression and partial indexes
CREATE OPERATOR CLASS misleading_ops FOR TYPE int USING dolt_prolly_index AS
  OPERATOR 3 <>, FUNCTION 1 btint4cmp(int,int);
CREATE INDEX bad_operators ON p(id misleading_ops);
ERROR:  prolly phase 2 does not support custom index operators
DROP OPERATOR CLASS misleading_ops USING dolt_prolly_index;
ALTER TABLE p ALTER COLUMN id TYPE text;
ERROR:  prolly phase 2 does not support ALTER TABLE (schema versioning is not implemented)
CREATE TABLE bad_type(v gtsvector) USING dolt_prolly_table;
ERROR:  prolly storage rejects type gtsvector
DETAIL:  Only codecs verified to exclude non-portable identifiers are supported.
HINT:  OID and other local identifier translation is not implemented.
INSERT INTO u VALUES(1,1) ON CONFLICT DO NOTHING;
ERROR:  prolly phase 2 does not support non-MVCC snapshots
SELECT * FROM p FOR UPDATE;
ERROR:  prolly phase 2 does not support row locking
DROP TABLE p,q,u,large_text;
